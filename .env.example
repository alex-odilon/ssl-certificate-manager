# SSL Certificate Manager — Environment Configuration
# Copy this file to .env and fill in ALL values before deploying.
# NEVER commit .env to git.

# ── Security ──────────────────────────────────────────────────────────────────
# Generate with: openssl rand -hex 32
SECRET_KEY=CHANGE_ME_generate_with_openssl_rand_hex_32

# Separate key for encrypting files/PFX passwords (distinct from SECRET_KEY)
# Generate with: openssl rand -hex 32
ENCRYPTION_KEY=CHANGE_ME_generate_with_openssl_rand_hex_32

# ── Admin Account ─────────────────────────────────────────────────────────────
ADMIN_EMAIL=admin@bsatech.io
ADMIN_USERNAME=admin
ADMIN_PASSWORD=CHANGE_ME_strong_password_here

# ── Database ──────────────────────────────────────────────────────────────────
POSTGRES_USER=sslmanager
POSTGRES_PASSWORD=CHANGE_ME_db_password
POSTGRES_DB=sslmanager
DATABASE_URL=postgresql://sslmanager:CHANGE_ME_db_password@postgres:5432/sslmanager

# ── Application ───────────────────────────────────────────────────────────────
CORS_ORIGINS=https://ssl-manager.bsatech.io
ACCESS_TOKEN_EXPIRE_MINUTES=480

# Set to true ONLY for local development/debugging. NEVER in production.
ENABLE_DOCS=false
